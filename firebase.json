{
  "hosting": {
    "site": "rt-aba-tracker",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.gs",
      "**/*.jsx",
      "**/*.md",
      "analyst/**",
      "docs/**"
    ],
    "rewrites": [
      {
        "source": "/tracker",
        "destination": "/tracker/index.html"
      },
      {
        "source": "/clinical",
        "destination": "/clinical/index.html"
      }
    ]
  }
}
